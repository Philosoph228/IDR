PenaltyExcessCharacter: 2                          # edit distance 66224
PenaltyIndentedWhitespace: 2                       # edit distance 66194
PenaltyReturnTypeOnItsOwnLine: 2                   # did not affect the output
PointerAlignment: Left                             # edit distance 66182
